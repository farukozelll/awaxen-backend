# ============================================
# AWAXEN SERVİS PROXY - api.awaxen.com
# ============================================

# PgAdmin Proxy
server {
    listen 443 ssl;
    server_name pgadmin.awaxen.com;
    
    # SSL certificates
    ssl_certificate /etc/nginx/ssl/api.awaxen.com.crt;
    ssl_certificate_key /etc/nginx/ssl/api.awaxen.com.key;
    
    # Proxy to PgAdmin
    location / {
        proxy_pass http://pgadmin/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Script-Name /;
    }
}

# Flower Proxy
server {
    listen 443 ssl;
    server_name flower.awaxen.com;
    
    # SSL certificates
    ssl_certificate /etc/nginx/ssl/api.awaxen.com.crt;
    ssl_certificate_key /etc/nginx/ssl/api.awaxen.com.key;
    
    # Basic Auth
    auth_basic "Celery Flower";
    auth_basic_user_file /etc/nginx/conf.d/.htpasswd;
    
    # Proxy to Flower
    location / {
        proxy_pass http://flower/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# MinIO Console Proxy
server {
    listen 443 ssl;
    server_name console.awaxen.com;
    
    # SSL certificates
    ssl_certificate /etc/nginx/ssl/api.awaxen.com.crt;
    ssl_certificate_key /etc/nginx/ssl/api.awaxen.com.key;
    
    # Proxy to MinIO Console
    location / {
        proxy_pass http://minio_console/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

# Home Assistant Proxy
server {
    listen 443 ssl;
    server_name home.awaxen.com;
    
    # SSL certificates
    ssl_certificate /etc/nginx/ssl/api.awaxen.com.crt;
    ssl_certificate_key /etc/nginx/ssl/api.awaxen.com.key;
    
    # Proxy to Home Assistant
    location / {
        proxy_pass http://homeassistant/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # WebSocket support
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_http_version 1.1;
    }
}
